    <string name="model_tagline_qwen3_0_6b">"Piccolo · interamente in memoria"</string>
    <string name="model_description_qwen3_0_6b">"Qwen3 0.6B nella versione ufficiale a 8 bit (639 MB). Leggero; adatto per provare l’app e per risposte brevi."</string>
    <string name="model_tagline_qwen35_9b_q4">"Medio · interamente in memoria · immagini"</string>
    <string name="model_description_qwen35_9b_q4">"Qwen3.5 9B, un modello denso della stessa famiglia dei modelli più grandi di Equity, nella versione a 4 bit di Unsloth (5,7 GB). Resta interamente in memoria, quindi richiede più RAM libera dei modelli in streaming; il supporto per le immagini è un download facoltativo."</string>
    <string name="model_tagline_qwen35_9b_iq3">"Medio · interamente in memoria · meno RAM · immagini"</string>
    <string name="model_description_qwen35_9b_iq3">"Lo stesso Qwen3.5 9B nella versione dinamica a 3 bit di Unsloth (4,0 GB), per quando c’è meno memoria libera. Resta interamente in memoria; il supporto per le immagini è un download facoltativo. Non è ancora stato confrontato con la versione a 4 bit sul set di valutazione di Equity."</string>
    <string name="model_tagline_qwen36_35b_iq2m">"Grande · due volte la RAM del telefono · sperimentale"</string>
    <string name="model_description_qwen36_35b_iq2m">"Qwen3.6 35B-A3B, un modello mixture-of-experts con 3B parametri attivi per token, nella versione dinamica a 2,7 bit di Unsloth (11,9 GB). I pesi condivisi restano in memoria e gli esperti vengono letti dall’archiviazione quando servono a ogni token. Sul set di valutazione di Equity ha ottenuto lo stesso punteggio della versione a 4 bit."</string>
    <string name="model_tagline_qwen36_35b_q4km">"Grande · due volte la RAM del telefono · riferimento di qualità · sperimentale"</string>
    <string name="model_description_qwen36_35b_q4km">"Lo stesso Qwen3.6 35B-A3B nella versione dinamica a 4 bit di Unsloth (22,7 GB), il riferimento di qualità di Equity. I pesi condivisi restano in memoria e gli esperti vengono letti dall’archiviazione quando servono a ogni token."</string>
    <string name="model_tagline_qwen38_flash_next">"Enorme · sette volte la RAM del telefono · sperimentale"</string>
    <string name="model_description_qwen38_flash_next">"Qwen3.8 Flash Next: un modello mixture-of-experts da 125B (512 esperti, 10 per token) con una memoria n-gram da 51B, nella versione dinamica UD-Q2_K_XL di Unsloth (78,9 GB). Solo circa 3,4 GB restano in memoria; esperti e righe n-gram vengono letti dall’archiviazione quando servono a ogni token. Richiede circa 80 GB di spazio libero."</string>
