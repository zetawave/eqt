+bool llama_adapter_cvec::init_ablation(const llama_model & model) {
+    const auto & hparams = model.hparams;
+
+    GGML_ASSERT(ablation.empty());
+
+    std::map<ggml_backend_buffer_type_t, ggml_context *> ctx_map;
+    ablation.reserve(hparams.n_layer());
+    for (size_t il = 0; il < hparams.n_layer(); il++) {
+        ggml_backend_buffer_type_t buft = model.select_buft(il);
+        auto it = ctx_map.find(buft);
+        if (it == ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ hparams.n_layer()*ggml_tensor_overhead(),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context * ctx = ggml_init(params);
+            if (!ctx) {
+                LLAMA_LOG_ERROR("%s: failed to allocate context for ablation direction\n", __func__);
+                return false;
+            }
+            it = ctx_map.emplace(buft, ctx).first;
+            ablation_ctxs.emplace_back(ctx);
+        }
+        ablation.push_back(ggml_new_tensor_1d(it->second, GGML_TYPE_F32, hparams.n_embd));
+    }
+
+    for (auto & [buft, ctx] : ctx_map) {
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, buft);
+        if (!buf) {
+            LLAMA_LOG_ERROR("%s: failed to allocate buffer for ablation direction\n", __func__);
+            return false;
+        }
+        ablation_bufs.emplace_back(buf);
+    }
+
+    return true;
+}
+
+bool llama_adapter_cvec::apply_ablation(
+        const llama_model & model,
+        const float * data,
+        size_t len,
+        int32_t n_embd,
+        float scale,
+        int32_t il_start,
+        int32_t il_end) {
+    if (data == nullptr) {
+        ablation_start = -1;
+        ablation_end   = -1;
+        return true;
+    }
+
+    if (n_embd != (int) model.hparams.n_embd) {
+        LLAMA_LOG_ERROR("%s: ablation direction n_embd does not match model\n", __func__);
+        return false;
+    }
+
+    if (ablation.empty() && !init_ablation(model)) {
+        ablation.clear();
+        ablation_ctxs.clear();
+        ablation_bufs.clear();
+        return false;
+    }
+
+    ablation_layers = 0;
+    for (size_t il = 0; il < ablation.size(); il++) {
+        const size_t off = n_embd * il;
+        if (off + n_embd > len) {
+            break;
+        }
+        ggml_backend_tensor_set(ablation[il], data + off, 0, n_embd * ggml_element_size(ablation[il]));
+        ablation_layers = (int32_t) il + 1;
+    }
+
+    ablation_scale = scale;
+    ablation_start = il_start;
+    ablation_end   = il_end;
+
+    return true;
+}
