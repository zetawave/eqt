+// AArch64, including SVE builds: every AArch64 core has 128-bit NEON, and sizeless SVE vectors cannot form the
+// accumulator arrays of the generic kernel, which left SVE builds on the scalar fallback. Fixed NEON registers:
+// 4x4 vector accumulators + 4 B vectors + 1 broadcast = 21 of 32. Each C element accumulates over k in order, as
+// in the generic SIMD kernel.
+#include <arm_neon.h>
+
+static constexpr int GEMM_RM = 4;
+static constexpr int GEMM_RN = 4;
+
+template <int RM, int RN>
+static inline void simd_gemm_ukernel(
+    float       * GGML_RESTRICT C,
+    const float * GGML_RESTRICT A,
+    const float * GGML_RESTRICT B,
+    int K, int N)
+{
+    float32x4_t acc[RM][RN];
+    for (int i = 0; i < RM; i++) {
+        for (int r = 0; r < RN; r++) {
+            acc[i][r] = vld1q_f32(C + i * N + r * 4);
+        }
+    }
+    for (int kk = 0; kk < K; kk++) {
+        float32x4_t b[RN];
+        for (int r = 0; r < RN; r++) {
+            b[r] = vld1q_f32(B + kk * N + r * 4);
+        }
+        for (int i = 0; i < RM; i++) {
+            const float32x4_t a = vdupq_n_f32(A[i * K + kk]);
+            for (int r = 0; r < RN; r++) {
+                acc[i][r] = vfmaq_f32(acc[i][r], b[r], a);
+            }
+        }
+    }
+    for (int i = 0; i < RM; i++) {
+        for (int r = 0; r < RN; r++) {
+            vst1q_f32(C + i * N + r * 4, acc[i][r]);
+        }
+    }
+}
+
+template <int RM>
+static inline void simd_gemm_rows(
+    float       * GGML_RESTRICT C,
+    const float * GGML_RESTRICT A,
+    const float * GGML_RESTRICT B,
+    int K, int N)
+{
+    int jj = 0;
+    for (; jj + GEMM_RN * 4 <= N; jj += GEMM_RN * 4) {
+        simd_gemm_ukernel<RM, GEMM_RN>(C + jj, A, B + jj, K, N);
+    }
+    for (; jj + 4 <= N; jj += 4) {
+        simd_gemm_ukernel<RM, 1>(C + jj, A, B + jj, K, N);
+    }
+    for (; jj < N; jj++) {
+        for (int i = 0; i < RM; i++) {
+            float a = C[i * N + jj];
+            for (int kk = 0; kk < K; kk++) {
+                a += A[i * K + kk] * B[kk * N + jj];
+            }
+            C[i * N + jj] = a;
+        }
+    }
+}
+
+// C[M x N] += A[M x K] * B[K x N]
+static void simd_gemm(
+    float       * GGML_RESTRICT C,
+    const float * GGML_RESTRICT A,
+    const float * GGML_RESTRICT B,
+    int M, int K, int N)
+{
+    int ii = 0;
+    for (; ii + GEMM_RM <= M; ii += GEMM_RM) {
+        simd_gemm_rows<GEMM_RM>(C + ii * N, A + ii * K, B, K, N);
+    }
+    for (; ii < M; ii++) {
+        simd_gemm_rows<1>(C + ii * N, A + ii * K, B, K, N);
