+// [EQUITY] dst is the view of the cache row a state is read from and written back to; src[1] is the whole state
+// cache and src[2] the source row ids (one). Copies the source row into dst unless it is dst itself.
+static void llm_graph_copy_state_row(ggml_tensor * dst, int ith, int nth, void * /*userdata*/) {
+    const ggml_tensor * states = dst->src[1];
+    const int32_t source = *(const int32_t *) dst->src[2]->data;
+    const char * from = (const char *) states->data + (size_t) source*states->nb[1];
+    char * to = (char *) dst->data;
+    if (from == to) {
+        return;
+    }
+    const size_t size  = ggml_nbytes(dst);
+    const size_t chunk = (size + nth - 1)/nth;
+    const size_t begin = std::min(size, chunk*ith);
+    const size_t end   = std::min(size, begin + chunk);
+    memcpy(to + begin, from + begin, end - begin);
+}
