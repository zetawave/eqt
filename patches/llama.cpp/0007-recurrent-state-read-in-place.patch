+    // [EQUITY] One token of one sequence in one cell, without rollback slots (decoding): the state is read in place
+    // from the cache row its new state is written back to, so no gather copies it. The row first receives its
+    // source state when that is another row (a new sequence's zeroed row). Its only reader runs before that write.
+    if (!get_state_rows && n_seqs == 1 && ubatch.n_seq_tokens == 1 && kv_state->get_n_rs() == 1 &&
+        cparams.n_rs_seq == 0) {
+        const uint32_t head = kv_state->get_head();
+        const llm_graph_get_rows_fn in_place = [head, state_size](ggml_context * ctx, ggml_tensor * states, ggml_tensor * ids) {
+            ggml_tensor * row = ggml_view_2d(ctx, states, state_size, 1, states->nb[1], head*states->nb[1]);
+            ggml_tensor * args[] = { states, ids };
+            return ggml_custom_inplace(ctx, row, args, 2, llm_graph_copy_state_row, GGML_N_TASKS_MAX, nullptr);
+        };
+        return build_rs(s, inp->s_copy_tail, inp->s_copy_main, state_size, n_seqs,
+                        kv_state->get_n_rs(), head, kv_state->get_size(), kv_state->get_rs_z(), in_place);
+    }
+
     // a custom getter reads the states of the ubatch straight from the cache, so the gather skips the first
